# Create a Hive model-only project configured for AI-generated media/deepfake detection.
# Keep this secret server-side. Never prefix it with NEXT_PUBLIC_.
HIVE_API_KEY=

# Optional override. Defaults to Hive's V2 sync endpoint.
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync

# Maximum media file size accepted by this MVP route, in bytes.
MAX_UPLOAD_BYTES=8388608
